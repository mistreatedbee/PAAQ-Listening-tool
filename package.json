{
  "name": "paaq-listening-platform",
  "version": "0.1.0",
  "private": true,
  "description": "PAAQ Listening Platform — AI-native product intelligence monorepo",
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/dashboard",
    "build": "npm run build --workspace=apps/dashboard",
    "start": "npm run start --workspace=apps/dashboard",
    "sdk:sync-versions": "node scripts/sync-sdk-versions.mjs",
    "sdk:build": "npm run build --prefix apps/sdk-web",
    "sdk:pack": "npm run sdk:sync-versions && npm run sdk:build && npm pack --prefix apps/sdk-web",
    "sdk:release": "node scripts/release-sdk.mjs web",
    "sdk:release:dry-run": "node scripts/release-sdk.mjs web --dry-run",
    "sdk:announce": "node scripts/announce-sdk-release.mjs web"
  }
}
