{
  "name": "@paaq/web-sdk",
  "version": "1.3.1",
  "description": "PAAQ Intelligence SDK for React, Next.js, Vue, and any web app",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @paaq/sdk-core",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mistreatedbee/PAAQ-Listening-tool.git",
    "directory": "apps/sdk-web"
  },
  "keywords": [
    "paaq",
    "analytics",
    "intelligence",
    "sdk",
    "react",
    "nextjs",
    "vue"
  ],
  "license": "MIT",
  "dependencies": {
    "@paaq/sdk-core": "^1.0.0",
    "rrweb": "^2.1.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
