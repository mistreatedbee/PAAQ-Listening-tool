# ─── Dashboard (apps/dashboard/.env.local) ────────────────────────────────────
# Public Supabase config for the Next.js dashboard (safe to expose via NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute base URL of the deployed dashboard (used to build absolute links)
NEXT_PUBLIC_APP_URL=https://your-dashboard-domain.com

# ─── Edge Functions (set via: supabase secrets set ...) ──────────────────────
# AI provider — OpenRouter (https://openrouter.ai/api/v1), model stealth/ox-alpha.
# This is the ONLY AI key needed; all AI features route through OpenRouter.
OPENROUTER_API_KEY=your_key_here

# Supabase service role (edge functions read these automatically in the hosted env)
SUPABASE_URL=your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal secret guarding agent endpoints (onboard-agent etc.)
REPO_CONNECTOR_INTERNAL_SECRET=your-internal-secret

# Direct Postgres connection string used by DB-pipeline edge functions
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# AES-256-GCM key (base64) for encrypting stored database connector secrets
DB_CONNECTOR_ENCRYPTION_KEY=your-base64-32-byte-key
