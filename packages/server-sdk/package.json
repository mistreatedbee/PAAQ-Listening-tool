{
  "name": "@paaq/server-sdk",
  "version": "1.0.2",
  "description": "PAAQ Intelligence SDK for Node.js backends (Express and compatible frameworks)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @paaq/sdk-core",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "keywords": [
    "paaq",
    "analytics",
    "intelligence",
    "sdk",
    "nodejs",
    "express",
    "backend"
  ],
  "license": "MIT",
  "dependencies": {
    "@paaq/sdk-core": "file:../sdk-core"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
